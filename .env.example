# Copy to .env.local for local dev. In production, set these in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# Meta App → App settings → Basic → App secret. Used to verify X-Hub-Signature-256.
META_APP_SECRET=

# Random string you invent and paste into Meta's webhook settings.
# Generate with: openssl rand -hex 32
WA_VERIFY_TOKEN=

# Permanent System User token (whatsapp_business_messaging + whatsapp_business_management).
WA_ACCESS_TOKEN=

# WhatsApp Manager → Phone numbers → Phone number ID (not the phone number itself).
WA_PHONE_NUMBER_ID=

# Pinned Graph API version. See README "Upgrading the Graph API version".
WA_GRAPH_API_VERSION=v25.0

# Supabase → Project Settings → API. Use the secret key (sb_secret_...) or the
# legacy service_role key. Server-only: never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Protects /api/cron/retry. Vercel sends it automatically for cron runs.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# "true" makes the bot answer "pong" to a text message "ping". Test aid only.
AUTO_REPLY_PING=true
